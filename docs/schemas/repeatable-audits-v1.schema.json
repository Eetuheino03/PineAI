{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Eetuheino03/PineAI/blob/main/docs/schemas/repeatable-audits-v1.schema.json",
  "title": "PineAssure v0.7.0 Repeatable Field Audits module contract",
  "description": "Public request and response definitions for the offline operator-guided repeatable-audit workflow.",
  "type": "object",
  "$comment": "Validate an action body against its named definition in $defs. The root accepts any public request shape for tooling that does not know the action name.",
  "anyOf": [
    { "$ref": "#/$defs/repeatableAuditCapabilitiesRequest" },
    { "$ref": "#/$defs/resourceTelemetryRequest" },
    { "$ref": "#/$defs/createMeasurementPointRequest" },
    { "$ref": "#/$defs/listMeasurementPointsRequest" },
    { "$ref": "#/$defs/getMeasurementPointRequest" },
    { "$ref": "#/$defs/updateMeasurementPointRequest" },
    { "$ref": "#/$defs/archiveMeasurementPointRequest" },
    { "$ref": "#/$defs/createAuditRunRequest" },
    { "$ref": "#/$defs/listAuditRunsRequest" },
    { "$ref": "#/$defs/getAuditRunRequest" },
    { "$ref": "#/$defs/auditRunTransitionRequest" },
    { "$ref": "#/$defs/cancelAuditRunRequest" },
    { "$ref": "#/$defs/resolveAuditMeasurementRequest" },
    { "$ref": "#/$defs/auditMeasurementMutationRequest" },
    { "$ref": "#/$defs/generateAuditRunReportRequest" }
  ],
  "$defs": {
    "assessmentId": {
      "type": "string",
      "pattern": "^assessment_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "measurementPointId": {
      "type": "string",
      "pattern": "^mp_[0-9a-f]{16}$"
    },
    "auditRunId": {
      "type": "string",
      "pattern": "^ar_[0-9a-f]{16}$"
    },
    "auditMeasurementId": {
      "type": "string",
      "pattern": "^arm_[0-9a-f]{16}$"
    },
    "measurementProfileId": {
      "type": "string",
      "pattern": "^mprofile_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "measurementProfileVersionId": {
      "type": "string",
      "pattern": "^mprofile_r[0-9]{4}$"
    },
    "baselineVersionId": {
      "type": "string",
      "pattern": "^baseline_v[0-9]{4}$"
    },
    "assuranceProfileVersionId": {
      "type": "string",
      "pattern": "^assurance_v[0-9]{4}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot_[0-9a-f]{16}$"
    },
    "baselineModelId": {
      "type": "string",
      "pattern": "^bmodel_[0-9a-f]{16}$"
    },
    "comparisonId": {
      "type": "string",
      "pattern": "^comparison_[0-9a-f]{16}$"
    },
    "occurrenceSetId": {
      "type": "string",
      "pattern": "^occurrence_[0-9a-f]{16}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence_[0-9a-f]{12}$"
    },
    "digest64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullableRfc3339": {
      "anyOf": [
        { "$ref": "#/$defs/rfc3339" },
        { "type": "null" }
      ]
    },
    "pageLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "pageOffset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "measurementPointInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_label"],
      "properties": {
        "location_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "physical_notes": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "operator_instructions": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]*$"
        }
      }
    },
    "measurementPointChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "location_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "physical_notes": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "operator_instructions": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f]*$"
        }
      }
    },
    "measurementPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_point_id",
        "assessment_id",
        "location_label",
        "physical_notes",
        "operator_instructions",
        "status",
        "created_at",
        "archived_at",
        "revision"
      ],
      "properties": {
        "measurement_point_id": { "$ref": "#/$defs/measurementPointId" },
        "assessment_id": { "$ref": "#/$defs/assessmentId" },
        "location_label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "physical_notes": { "type": ["string", "null"], "maxLength": 1024 },
        "operator_instructions": { "type": ["string", "null"], "maxLength": 1024 },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "archived_at": { "$ref": "#/$defs/nullableRfc3339" },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": { "properties": { "archived_at": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "archived" } } },
          "then": { "properties": { "archived_at": { "$ref": "#/$defs/rfc3339" } } }
        }
      ]
    },
    "auditRunAssignmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_point_id",
        "measurement_profile_id",
        "measurement_profile_version_id",
        "baseline_version_id"
      ],
      "properties": {
        "measurement_point_id": { "$ref": "#/$defs/measurementPointId" },
        "measurement_profile_id": { "$ref": "#/$defs/measurementProfileId" },
        "measurement_profile_version_id": { "$ref": "#/$defs/measurementProfileVersionId" },
        "baseline_version_id": { "$ref": "#/$defs/baselineVersionId" }
      }
    },
    "auditRunInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "assurance_profile_version_id", "assignments"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "description": {
          "type": ["string", "null"],
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "due_at": { "$ref": "#/$defs/nullableRfc3339" },
        "assurance_profile_version_id": { "$ref": "#/$defs/assuranceProfileVersionId" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/auditRunAssignmentRequest" }
        }
      }
    },
    "auditRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "audit_run_id",
        "assessment_id",
        "name",
        "description",
        "status",
        "created_at",
        "started_at",
        "completed_at",
        "due_at",
        "pinned_assurance_profile_version_id",
        "pinned_assurance_profile_digest",
        "measurement_ids",
        "revision"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "audit_run_id": { "$ref": "#/$defs/auditRunId" },
        "assessment_id": { "$ref": "#/$defs/assessmentId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": ["string", "null"], "maxLength": 512 },
        "status": { "type": "string", "enum": ["draft", "in_progress", "completed", "cancelled"] },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "started_at": { "$ref": "#/$defs/nullableRfc3339" },
        "completed_at": { "$ref": "#/$defs/nullableRfc3339" },
        "due_at": { "$ref": "#/$defs/nullableRfc3339" },
        "pinned_assurance_profile_version_id": { "$ref": "#/$defs/assuranceProfileVersionId" },
        "pinned_assurance_profile_digest": { "$ref": "#/$defs/digest64" },
        "measurement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/auditMeasurementId" }
        },
        "revision": { "$ref": "#/$defs/revision" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "draft" } }, "required": ["status"] },
          "then": {
            "properties": {
              "started_at": { "type": "null" },
              "completed_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] },
          "then": {
            "properties": {
              "started_at": { "$ref": "#/$defs/rfc3339" },
              "completed_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "started_at": { "$ref": "#/$defs/rfc3339" },
              "completed_at": { "$ref": "#/$defs/rfc3339" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "cancelled" } }, "required": ["status"] },
          "then": {
            "properties": {
              "completed_at": { "$ref": "#/$defs/rfc3339" }
            }
          }
        }
      ]
    },
    "auditRunMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "measurement_id",
        "audit_run_id",
        "measurement_point_id",
        "status",
        "created_at",
        "revision",
        "provenance_status"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "measurement_id": { "$ref": "#/$defs/auditMeasurementId" },
        "audit_run_id": { "$ref": "#/$defs/auditRunId" },
        "measurement_point_id": { "$ref": "#/$defs/measurementPointId" },
        "status": { "type": "string", "enum": ["pending", "resolved", "completed", "failed"] },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "revision": { "$ref": "#/$defs/revision" },
        "provenance_status": { "type": "string", "enum": ["pinned", "legacy_unpinned"] },
        "measurement_point_revision": { "$ref": "#/$defs/revision" },
        "measurement_point_digest": { "$ref": "#/$defs/digest64" },
        "measurement_point_snapshot": { "$ref": "#/$defs/measurementPoint" },
        "measurement_profile_id": { "$ref": "#/$defs/measurementProfileId" },
        "measurement_profile_version_id": { "$ref": "#/$defs/measurementProfileVersionId" },
        "measurement_profile_digest": { "$ref": "#/$defs/digest64" },
        "baseline_version_id": { "$ref": "#/$defs/baselineVersionId" },
        "baseline_type": { "type": "string", "enum": ["consensus", "single_scan"] },
        "baseline_digest": { "$ref": "#/$defs/digest64" },
        "baseline_record_digest": { "$ref": "#/$defs/digest64" },
        "baseline_model_id": { "$ref": "#/$defs/baselineModelId" },
        "baseline_model_digest": { "$ref": "#/$defs/digest64" },
        "baseline_snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "baseline_snapshot_digest": { "$ref": "#/$defs/digest64" },
        "assurance_profile_version_id": { "$ref": "#/$defs/assuranceProfileVersionId" },
        "assurance_profile_digest": { "$ref": "#/$defs/digest64" },
        "source_recon_id": { "type": ["string", "null"], "maxLength": 128 },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "snapshot_digest": { "$ref": "#/$defs/digest64" },
        "snapshot_record_digest": { "$ref": "#/$defs/digest64" },
        "comparability_status": { "type": "string", "enum": ["comparable", "partially_comparable", "not_comparable"] },
        "resolved_at": { "$ref": "#/$defs/rfc3339" },
        "comparison_id": { "$ref": "#/$defs/comparisonId" },
        "comparison_digest": { "$ref": "#/$defs/digest64" },
        "occurrence_set_id": { "$ref": "#/$defs/occurrenceSetId" },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "completed_at": { "$ref": "#/$defs/rfc3339" },
        "failed_stage": { "type": "string", "enum": ["resolution", "comparison"] },
        "retry_target": { "type": "string", "enum": ["pending", "resolved"] },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "error_message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "failed_at": { "$ref": "#/$defs/rfc3339" }
      },
      "allOf": [
        {
          "if": { "properties": { "provenance_status": { "const": "pinned" } } },
          "then": {
            "required": [
              "measurement_point_revision",
              "measurement_point_digest",
              "measurement_point_snapshot",
              "measurement_profile_id",
              "measurement_profile_version_id",
              "measurement_profile_digest",
              "baseline_version_id",
              "baseline_type",
              "baseline_digest",
              "baseline_record_digest",
              "assurance_profile_version_id",
              "assurance_profile_digest"
            ]
          }
        },
        {
          "if": { "properties": { "baseline_type": { "const": "consensus" } }, "required": ["baseline_type"] },
          "then": {
            "required": ["baseline_model_id", "baseline_model_digest"],
            "not": {
              "anyOf": [
                { "required": ["baseline_snapshot_id"] },
                { "required": ["baseline_snapshot_digest"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "baseline_type": { "const": "single_scan" } }, "required": ["baseline_type"] },
          "then": {
            "required": ["baseline_snapshot_id", "baseline_snapshot_digest"],
            "not": {
              "anyOf": [
                { "required": ["baseline_model_id"] },
                { "required": ["baseline_model_digest"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["snapshot_id"] },
                { "required": ["snapshot_digest"] },
                { "required": ["snapshot_record_digest"] },
                { "required": ["comparability_status"] },
                { "required": ["source_recon_id"] },
                { "required": ["resolved_at"] },
                { "required": ["comparison_id"] },
                { "required": ["comparison_digest"] },
                { "required": ["occurrence_set_id"] },
                { "required": ["evidence_ids"] },
                { "required": ["completed_at"] },
                { "required": ["failed_stage"] },
                { "required": ["retry_target"] },
                { "required": ["error_code"] },
                { "required": ["error_message"] },
                { "required": ["failed_at"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": {
            "required": ["snapshot_id", "snapshot_digest", "comparability_status", "resolved_at"],
            "not": {
              "anyOf": [
                { "required": ["comparison_id"] },
                { "required": ["comparison_digest"] },
                { "required": ["occurrence_set_id"] },
                { "required": ["evidence_ids"] },
                { "required": ["completed_at"] },
                { "required": ["failed_stage"] },
                { "required": ["retry_target"] },
                { "required": ["error_code"] },
                { "required": ["error_message"] },
                { "required": ["failed_at"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": {
            "required": ["snapshot_id", "snapshot_digest", "comparability_status", "comparison_id", "comparison_digest", "occurrence_set_id", "evidence_ids", "completed_at"],
            "not": {
              "anyOf": [
                { "required": ["resolved_at"] },
                { "required": ["failed_stage"] },
                { "required": ["retry_target"] },
                { "required": ["error_code"] },
                { "required": ["error_message"] },
                { "required": ["failed_at"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "required": ["failed_stage", "retry_target", "error_code", "error_message", "failed_at"],
            "not": {
              "anyOf": [
                { "required": ["comparison_id"] },
                { "required": ["comparison_digest"] },
                { "required": ["occurrence_set_id"] },
                { "required": ["evidence_ids"] },
                { "required": ["completed_at"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "failed" },
              "failed_stage": { "const": "resolution" }
            },
            "required": ["status", "failed_stage"]
          },
          "then": {
            "properties": { "retry_target": { "const": "pending" } },
            "not": {
              "anyOf": [
                { "required": ["snapshot_id"] },
                { "required": ["snapshot_digest"] },
                { "required": ["snapshot_record_digest"] },
                { "required": ["comparability_status"] },
                { "required": ["source_recon_id"] },
                { "required": ["resolved_at"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "failed" },
              "failed_stage": { "const": "comparison" }
            },
            "required": ["status", "failed_stage"]
          },
          "then": {
            "required": ["snapshot_id", "snapshot_digest", "comparability_status", "resolved_at"],
            "properties": { "retry_target": { "const": "resolved" } }
          }
        },
        {
          "if": {
            "properties": {
              "provenance_status": { "const": "pinned" },
              "status": { "enum": ["resolved", "completed"] }
            },
            "required": ["provenance_status", "status"]
          },
          "then": { "required": ["snapshot_record_digest"] }
        },
        {
          "if": {
            "properties": {
              "provenance_status": { "const": "pinned" },
              "status": { "const": "failed" },
              "failed_stage": { "const": "comparison" }
            },
            "required": ["provenance_status", "status", "failed_stage"]
          },
          "then": { "required": ["snapshot_record_digest"] }
        }
      ]
    },
    "auditRunMeasurementPending": {
      "allOf": [
        { "$ref": "#/$defs/auditRunMeasurement" },
        { "properties": { "status": { "const": "pending" } } }
      ]
    },
    "auditRunMeasurementResolved": {
      "allOf": [
        { "$ref": "#/$defs/auditRunMeasurement" },
        { "properties": { "status": { "const": "resolved" } } }
      ]
    },
    "auditRunMeasurementCompleted": {
      "allOf": [
        { "$ref": "#/$defs/auditRunMeasurement" },
        { "properties": { "status": { "const": "completed" } } }
      ]
    },
    "auditRunMeasurementFailed": {
      "allOf": [
        { "$ref": "#/$defs/auditRunMeasurement" },
        { "properties": { "status": { "const": "failed" } } }
      ]
    },
    "auditWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_measurement_id", "next_measurement_id", "next_action"],
      "properties": {
        "current_measurement_id": {
          "anyOf": [
            { "$ref": "#/$defs/auditMeasurementId" },
            { "type": "null" }
          ]
        },
        "next_measurement_id": {
          "anyOf": [
            { "$ref": "#/$defs/auditMeasurementId" },
            { "type": "null" }
          ]
        },
        "next_action": {
          "type": "string",
          "enum": ["start_run", "resolve_measurement", "save_comparison", "retry_measurement", "complete_run", "generate_report"]
        }
      }
    },
    "assessmentCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_point_active_limit",
        "measurement_point_active_used",
        "measurement_point_active_available",
        "measurement_point_total_limit",
        "measurement_point_total_used",
        "measurement_point_total_available",
        "audit_run_limit",
        "audit_run_used",
        "audit_run_available",
        "assignments_per_run_limit",
        "in_progress_audit_run_limit",
        "in_progress_audit_run_used",
        "in_progress_audit_run_available"
      ],
      "properties": {
        "measurement_point_active_limit": { "const": 16 },
        "measurement_point_active_used": { "type": "integer", "minimum": 0, "maximum": 16 },
        "measurement_point_active_available": { "type": "integer", "minimum": 0, "maximum": 16 },
        "measurement_point_total_limit": { "const": 32 },
        "measurement_point_total_used": { "type": "integer", "minimum": 0, "maximum": 32 },
        "measurement_point_total_available": { "type": "integer", "minimum": 0, "maximum": 32 },
        "audit_run_limit": { "const": 32 },
        "audit_run_used": { "type": "integer", "minimum": 0, "maximum": 32 },
        "audit_run_available": { "type": "integer", "minimum": 0, "maximum": 32 },
        "assignments_per_run_limit": { "const": 16 },
        "in_progress_audit_run_limit": { "const": 1 },
        "in_progress_audit_run_used": { "type": "integer", "minimum": 0, "maximum": 1 },
        "in_progress_audit_run_available": { "type": "integer", "minimum": 0, "maximum": 1 },
        "snapshot_limit": { "type": "integer", "minimum": 0 },
        "snapshot_used": { "type": "integer", "minimum": 0 },
        "snapshot_available": { "type": "integer", "minimum": 0 },
        "comparison_limit": { "type": "integer", "minimum": 0 },
        "comparison_used": { "type": "integer", "minimum": 0 },
        "comparison_available": { "type": "integer", "minimum": 0 },
        "occurrence_limit": { "type": "integer", "minimum": 0 },
        "occurrence_used": { "type": "integer", "minimum": 0 },
        "occurrence_available": { "type": "integer", "minimum": 0 },
        "event_limit": { "type": "integer", "minimum": 0 },
        "event_used": { "type": "integer", "minimum": 0 },
        "event_available": { "type": "integer", "minimum": 0 },
        "event_reserved_for_run_closure": { "type": "integer", "minimum": 0 },
        "event_available_for_non_terminal": { "type": "integer", "minimum": 0 }
      }
    },
    "auditRunDetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "audit_run", "measurements", "ready_to_start", "workflow", "assessment_capacity"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "assessment_revision": { "$ref": "#/$defs/revision" },
        "audit_run": { "$ref": "#/$defs/auditRun" },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/auditRunMeasurement" }
        },
        "ready_to_start": { "type": "boolean" },
        "workflow": { "$ref": "#/$defs/auditWorkflow" },
        "assessment_capacity": { "$ref": "#/$defs/assessmentCapacity" }
      }
    },
    "repeatableAuditCapabilitiesRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "repeatableAuditCapabilitiesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "backend_version", "product", "public_actions", "limits", "states", "storage_layout", "report", "strict_exclusions", "hardware_calibrated"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "backend_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "technical_module_id", "tagline"],
          "properties": {
            "name": { "const": "PineAssure" },
            "technical_module_id": { "const": "PineAI" },
            "tagline": { "const": "Baseline. Detect drift. Prove changes." }
          }
        },
        "public_actions": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_measurement_points_per_assessment", "total_measurement_points_per_assessment", "measurement_points_per_audit_run", "audit_runs_per_assessment", "simultaneous_active_audit_runs_per_assessment", "simultaneous_scan_processing", "raw_recon_bytes", "evidence_references_per_measurement"],
          "properties": {
            "active_measurement_points_per_assessment": { "const": 16 },
            "total_measurement_points_per_assessment": { "const": 32 },
            "measurement_points_per_audit_run": { "const": 16 },
            "audit_runs_per_assessment": { "const": 32 },
            "simultaneous_active_audit_runs_per_assessment": { "const": 1 },
            "simultaneous_scan_processing": { "const": 1 },
            "raw_recon_bytes": { "const": 8388608 },
            "evidence_references_per_measurement": { "const": 100 }
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audit_run", "measurement", "resume"],
          "properties": {
            "audit_run": { "const": ["draft", "in_progress", "completed", "cancelled"] },
            "measurement": { "const": ["pending", "resolved", "completed", "failed"] },
            "resume": { "const": "reload_in_progress_run" }
          }
        },
        "storage_layout": { "type": "string", "minLength": 1, "maxLength": 256 },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formats", "privacy_profiles", "terminal_states"],
          "properties": {
            "formats": { "const": ["html", "json"] },
            "privacy_profiles": { "const": ["local_full", "share_safe"] },
            "terminal_states": { "const": ["completed", "cancelled"] }
          }
        },
        "strict_exclusions": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "hardware_calibrated": { "const": false }
      }
    },
    "resourceTelemetryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": { "$ref": "#/$defs/assessmentId" }
      }

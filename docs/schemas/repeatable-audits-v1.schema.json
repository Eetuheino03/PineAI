        "warnings": { "type": "array", "items": { "type": "string" } },
        "memory": { "type": "object", "additionalProperties": { "type": ["integer", "null"], "minimum": 0 } },
        "load_average": { "type": "object", "additionalProperties": { "type": ["number", "null"], "minimum": 0 } },
        "storage": { "type": "object" },
        "artifacts": { "type": "object" },
        "scan_processing": { "type": "object" },
        "guard": { "type": "object" },
        "assessment_filter_applied": { "type": "boolean" }

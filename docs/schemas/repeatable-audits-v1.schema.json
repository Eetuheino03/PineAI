      }
    },
    "resolveAuditMeasurementResponse": { "$ref": "#/$defs/auditMeasurementMutationResponse" },
    "saveAuditMeasurementComparisonResponse": { "$ref": "#/$defs/auditMeasurementMutationResponse" },
    "retryAuditMeasurementResponse": { "$ref": "#/$defs/auditMeasurementMutationResponse" },
    "generateAuditRunReportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "audit_run_id", "format", "privacy_profile"],
      "properties": {
        "assessment_id": { "$ref": "#/$defs/assessmentId" },
        "audit_run_id": { "$ref": "#/$defs/auditRunId" },
        "format": { "type": "string", "enum": ["json", "html"] },
        "privacy_profile": { "type": "string", "enum": ["local_full", "share_safe"] }
      }
    },
    "generateAuditRunReportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "report_id", "audit_run_id", "format", "privacy_profile", "generated_at", "fact_digest", "content_sha256", "filename", "mime_type", "content"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "report_id": { "type": "string", "pattern": "^audit_report_[0-9a-f]{16}$" },
        "audit_run_id": { "$ref": "#/$defs/auditRunId" },
        "format": { "type": "string", "enum": ["json", "html"] },
        "privacy_profile": { "type": "string", "enum": ["local_full", "share_safe"] },
        "generated_at": { "$ref": "#/$defs/rfc3339" },
        "fact_digest": { "$ref": "#/$defs/digest64" },
        "content_sha256": { "$ref": "#/$defs/digest64" },
        "filename": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
        "mime_type": { "type": "string", "enum": ["application/json", "text/html"] },
        "content": { "type": "string" }
      }
    },

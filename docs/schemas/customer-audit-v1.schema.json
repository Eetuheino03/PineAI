    },
    "maxSourceAgeHours": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 168,
      "default": 24
    },
    "previewConsensusBaselineRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations"],
      "properties": {
        "observations": { "$ref": "#/definitions/consensusObservations" },

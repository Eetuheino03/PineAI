          "$ref": "#/definitions/maxSourceAgeHours"
        }
      }
    },
    "createConsensusBaselineRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "expected_revision",
        "observations"
      ],
      "properties": {
        "assessment_id": { "$ref": "#/definitions/assessmentId" },
        "expected_revision": { "$ref": "#/definitions/revision" },
        "observations": { "$ref": "#/definitions/consensusObservations" },

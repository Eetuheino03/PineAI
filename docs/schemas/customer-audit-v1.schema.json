    "customerReportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "format",
        "scope",
        "privacy_profile",
        "filename",
        "mime_type",
        "sha256",
        "scope_digest",
        "report_sha256",

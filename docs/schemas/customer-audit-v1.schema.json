          "type": "object",
          "required": [
            "python_version",
            "python_3_8_compatible",
            "platform"
          ],
          "properties": {
            "python_version": { "type": "string" },
            "python_3_8_compatible": { "type": "boolean" },
            "platform": { "type": "string" }
          }
        },
        "device": { "$ref": "#/definitions/genericObject" },
        "interfaces": { "$ref": "#/definitions/genericObject" },
        "bands": {
          "type": "object",
          "required": ["2.4", "5", "6"],
          "properties": {
            "2.4": { "const": "profile_declared" },
            "5": { "const": "operator_confirmation_required" },
            "6": { "const": "unsupported_on_mark_vii" }
          }
        },
        "recon_control": { "const": false },
        "saved_recon_only": { "const": true },
        "backend_version": { "type": "string" }
      }

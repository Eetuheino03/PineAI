{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Eetuheino03/PineAI/docs/schemas/audit-run-report-v1.schema.json",
  "title": "PineAssure AuditRun canonical fact model v1",
  "description": "Canonical JSON facts used by both the JSON and script-free HTML AuditRun report renderers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "assessment_id",
    "audit_run",
    "generated_at",
    "workflow",
    "capacity_limits",
    "summary",
    "measurements",
    "audit_events",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "technical_module_id", "tagline"],
      "properties": {
        "name": { "const": "PineAssure" },
        "technical_module_id": { "const": "PineAI" },
        "tagline": { "const": "Baseline. Detect drift. Prove changes." }
      }
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^assessment_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "audit_run": {
      "type": "object",
      "required": [
        "schema_version",
        "audit_run_id",
        "assessment_id",
        "name",
        "status",
        "created_at",
        "completed_at",
        "pinned_assurance_profile_version_id",
        "pinned_assurance_profile_digest",
        "measurement_ids",
        "revision"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "audit_run_id": { "type": "string", "pattern": "^ar_[0-9a-f]{16}$" },
        "assessment_id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": ["string", "null"], "maxLength": 512 },
        "status": { "enum": ["completed", "cancelled"] },
        "created_at": { "$ref": "#/$defs/rfc3339" },
        "started_at": { "oneOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }] },
        "completed_at": { "$ref": "#/$defs/rfc3339" },
        "due_at": { "oneOf": [{ "$ref": "#/$defs/rfc3339" }, { "type": "null" }] },
        "pinned_assurance_profile_version_id": { "type": "string", "pattern": "^assurance_v[0-9]{4}$" },
        "pinned_assurance_profile_digest": { "$ref": "#/$defs/sha256" },
        "measurement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^arm_[0-9a-f]{16}$" }
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "generated_at": { "$ref": "#/$defs/rfc3339" },
    "workflow": {
      "type": "object",
      "additionalProperties": true
    },
    "capacity_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_measurement_points_per_assessment",
        "total_measurement_points_per_assessment",
        "measurement_points_per_audit_run",
        "audit_runs_per_assessment",
        "simultaneous_active_audit_runs",
        "simultaneous_scan_processing"
      ],
      "properties": {
        "active_measurement_points_per_assessment": { "const": 16 },
        "total_measurement_points_per_assessment": { "const": 32 },
        "measurement_points_per_audit_run": { "const": 16 },
        "audit_runs_per_assessment": { "const": 32 },
        "simultaneous_active_audit_runs": { "const": 1 },
        "simultaneous_scan_processing": { "const": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_count",
        "measurement_status_counts",
        "finding_count",
        "severity_counts"
      ],
      "properties": {
        "measurement_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "measurement_status_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "severity_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "measurement_id",
          "audit_run_id",
          "measurement_point_id",
          "status",
          "created_at",
          "revision",
          "provenance_status"
        ],
        "properties": {
          "schema_version": { "const": "1.1" },
          "measurement_id": { "type": "string", "pattern": "^arm_[0-9a-f]{16}$" },
          "audit_run_id": { "type": "string", "pattern": "^ar_[0-9a-f]{16}$" },
          "measurement_point_id": { "type": "string", "pattern": "^mp_[0-9a-f]{16}$" },
          "status": { "enum": ["pending", "resolved", "completed", "failed"] },
          "created_at": { "$ref": "#/$defs/rfc3339" },
          "revision": { "type": "integer", "minimum": 1 },
          "provenance_status": { "enum": ["pinned", "legacy_unpinned"] },
          "snapshot": { "type": "object" },
          "comparison": { "type": "object" },
          "occurrence": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "audit_events": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["sequence", "event_id", "event_type", "recorded_at", "revision", "data"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "event_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "recorded_at": { "$ref": "#/$defs/rfc3339" },
          "revision": { "type": "integer", "minimum": 1 },
          "data": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "maxLength": 1024 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eetuheino03/PineAI/docs/schemas/frontend-v1.schema.json",
  "title": "PineAI frontend settings contract",
  "type": "object",
  "$defs": {
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "covers", "is_default"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[ -~]+$"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["2.4", "5"]
          }
        },
        "is_default": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "share_ssids", "supported_bands"],
      "properties": {
        "language": {
          "enum": ["en", "fi"]
        },
        "share_ssids": {
          "type": "boolean"
        },
        "supported_bands": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/band"
          }
        }
      }
    }
  },
  "required": ["schema_version", "settings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    }
  }
}
